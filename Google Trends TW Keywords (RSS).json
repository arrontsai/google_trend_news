        "functionCode": "const data = $json.data || [];\nif (!data.length) return [{ json: { instSummary: '無法人資料' } }];\n\nconst total = data.reduce((a,b)=>a+b.buy_sell,0);\nreturn [{ json: { instSummary: `三大法人昨日合計${total>0?'買超':'賣超'} ${Math.abs(total).toLocaleString()} 張` } }];"
