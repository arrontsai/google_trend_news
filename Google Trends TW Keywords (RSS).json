    {
      "parameters": {
        "functionCode": "const items = $input.all();\nlet news = '';\nlet inst = '';\n\n// 遍歷每個來源\nfor (const i of items) {\n  const json = i.json;\n\n  // FinMind / Institutional\n  if (json.instSummary) {\n    inst = json.instSummary;\n  }\n\n  // NewsData.io\n  if (Array.isArray(json.results)) {\n    for (const n of json.results) {\n      const title = n.title || '未命名';\n      const desc = n.description || '';\n      news += `【${title}】\\n${desc}\\n\\n---\\n\\n`;\n    }\n  }\n\n  // Massive / Finnhub\n  if (json.title || json.headline) {\n    const title = json.title || json.headline;\n    const desc = json.description || json.summary || '';\n    news += `【${title}】\\n${desc}\\n\\n---\\n\\n`;\n  }\n}\n\nreturn [{ json: { newsText: news, instSummary: inst } }];\n"
      },
